<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TeamsMobileUI.CalendarPage"
             Title="Calendar">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0"
              Padding="20"
              ColumnDefinitions="Auto,*,Auto">

            <Label Text="☰"
                   FontSize="28"
                   VerticalOptions="Center" />

            <Label Grid.Column="1"
                   Text="Calendar"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <Label Grid.Column="2"
                   Text="+"
                   FontSize="28"
                   VerticalOptions="Center" />
        </Grid>


        <!-- Calendar Content -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="20"
                                 Spacing="20">

                <!-- Month Navigation -->
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <Button Text="‹"
                            FontSize="25"
                            WidthRequest="45"
                            HeightRequest="45"
                            Padding="0" />

                    <Label Grid.Column="1"
                           Text="September 2026"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />

                    <Button Grid.Column="2"
                            Text="›"
                            FontSize="25"
                            WidthRequest="45"
                            HeightRequest="45"
                            Padding="0" />

                </Grid>


                <!-- Days of Week -->
                <Grid ColumnDefinitions="*,*,*,*,*,*,*">

                    <Label Text="S"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold" />

                    <Label Grid.Column="1"
                           Text="M"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold" />

                    <Label Grid.Column="2"
                           Text="T"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold" />

                    <Label Grid.Column="3"
                           Text="W"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold" />

                    <Label Grid.Column="4"
                           Text="T"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold" />

                    <Label Grid.Column="5"
                           Text="F"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold" />

                    <Label Grid.Column="6"
                           Text="S"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold" />

                </Grid>


                <!-- Calendar Dates -->
                <Grid RowDefinitions="*,*,*,*,*"
                      ColumnDefinitions="*,*,*,*,*,*,*"
                      RowSpacing="12"
                      ColumnSpacing="5">

                    <Label Grid.Column="2"
                           Text="1"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Column="3"
                           Text="2"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Column="4"
                           Text="3"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Column="5"
                           Text="4"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Column="6"
                           Text="5"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="1"
                           Text="6"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="1"
                           Grid.Column="1"
                           Text="7"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="1"
                           Grid.Column="2"
                           Text="8"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="1"
                           Grid.Column="3"
                           Text="9"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="1"
                           Grid.Column="4"
                           Text="10"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="1"
                           Grid.Column="5"
                           Text="11"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="1"
                           Grid.Column="6"
                           Text="12"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="2"
                           Text="13"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="2"
                           Grid.Column="1"
                           Text="14"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="2"
                           Grid.Column="2"
                           Text="15"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="2"
                           Grid.Column="3"
                           Text="16"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="2"
                           Grid.Column="4"
                           Text="17"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="2"
                           Grid.Column="5"
                           Text="18"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="2"
                           Grid.Column="6"
                           Text="19"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="3"
                           Text="20"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="3"
                           Grid.Column="1"
                           Text="21"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="3"
                           Grid.Column="2"
                           Text="22"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="3"
                           Grid.Column="3"
                           Text="23"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="3"
                           Grid.Column="4"
                           Text="24"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="3"
                           Grid.Column="5"
                           Text="25"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="3"
                           Grid.Column="6"
                           Text="26"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="4"
                           Text="27"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="4"
                           Grid.Column="1"
                           Text="28"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="4"
                           Grid.Column="2"
                           Text="29"
                           HorizontalTextAlignment="Center" />

                    <Label Grid.Row="4"
                           Grid.Column="3"
                           Text="30"
                           HorizontalTextAlignment="Center" />

                </Grid>


                <!-- Upcoming -->
                <Label Text="Upcoming"
                       FontSize="20"
                       FontAttributes="Bold"
                       Margin="0,10,0,0" />

                <Border Padding="15"
                        BackgroundColor="#F5F5F5"
                        StrokeThickness="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="5">

                        <Label Text="Team Meeting"
                               FontSize="17"
                               FontAttributes="Bold" />

                        <Label Text="10:00 AM"
                               FontSize="14"
                               TextColor="Gray" />

                        <Label Text="Development Team"
                               FontSize="13"
                               TextColor="Gray" />

                    </VerticalStackLayout>

                </Border>


                <Border Padding="15"
                        BackgroundColor="#F5F5F5"
                        StrokeThickness="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="5">

                        <Label Text="College Project"
                               FontSize="17"
                               FontAttributes="Bold" />

                        <Label Text="2:00 PM"
                               FontSize="14"
                               TextColor="Gray" />

                        <Label Text="Assignment discussion"
                               FontSize="13"
                               TextColor="Gray" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>


        <!-- Bottom Navigation -->
        <Grid Grid.Row="2"
              Padding="10,8"
              ColumnDefinitions="*,*,*,*,*">

            <!-- Activity -->
            <VerticalStackLayout Grid.Column="0"
                                 HorizontalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnActivityTapped" />
                </VerticalStackLayout.GestureRecognizers>

                <Label Text="⌂"
                       FontSize="22"
                       HorizontalTextAlignment="Center" />

                <Label Text="Activity"
                       FontSize="11"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- Chat -->
            <VerticalStackLayout Grid.Column="1"
                                 HorizontalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChatTapped" />
                </VerticalStackLayout.GestureRecognizers>

                <Label Text="💬"
                       FontSize="22"
                       HorizontalTextAlignment="Center" />

                <Label Text="Chat"
                       FontSize="11"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- Teams -->
            <VerticalStackLayout Grid.Column="2"
                                 HorizontalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTeamsTapped" />
                </VerticalStackLayout.GestureRecognizers>

                <Label Text="👥"
                       FontSize="22"
                       HorizontalTextAlignment="Center" />

                <Label Text="Teams"
                       FontSize="11"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- Calendar -->
            <VerticalStackLayout Grid.Column="3"
                                 HorizontalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCalendarTapped" />
                </VerticalStackLayout.GestureRecognizers>

                <Label Text="📅"
                       FontSize="22"
                       TextColor="#5B3A9D"
                       HorizontalTextAlignment="Center" />

                <Label Text="Calendar"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="#5B3A9D"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- More -->
            <VerticalStackLayout Grid.Column="4"
                                 HorizontalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMoreTapped" />
                </VerticalStackLayout.GestureRecognizers>

                <Label Text="•••"
                       FontSize="22"
                       HorizontalTextAlignment="Center" />

                <Label Text="More"
                       FontSize="11"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>