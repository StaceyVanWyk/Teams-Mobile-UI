<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TeamsMobileUI.MainPage">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid
            Grid.Row="0"
            Padding="20"
            ColumnDefinitions="Auto,*,Auto">

            <Label
                Text="☰"
                FontSize="28"
                VerticalOptions="Center" />

            <Label
                Grid.Column="1"
                Text="Teams"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Label
                Grid.Column="2"
                Text="👤"
                FontSize="24"
                VerticalOptions="Center" />

        </Grid>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="20"
                Spacing="15">

                <!-- Search -->
                <Label
                    Text="Search"
                    FontSize="20"
                    FontAttributes="Bold" />

                <Entry
                    Placeholder="Search"
                    HeightRequest="50" />

                <!-- Chats Heading and New Chat Button -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    Margin="0,10,0,0">

                    <Label
                        Text="Chats"
                        FontSize="20"
                        FontAttributes="Bold"
                        VerticalOptions="Center" />

                    <Button
                        Grid.Column="1"
                        Text="+"
                        FontSize="22"
                        WidthRequest="45"
                        HeightRequest="45"
                        CornerRadius="23"
                        Padding="0" />

                </Grid>

                <!-- Chat List -->
                <CollectionView
                    ItemsSource="{Binding Chats}"
                    SelectionMode="None">

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Grid
                                Padding="10,12"
                                ColumnDefinitions="60,*,Auto"
                                RowDefinitions="Auto,Auto">

                                <!-- Make chat clickable -->
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnChatTapped" />
                                </Grid.GestureRecognizers>

                                <!-- Profile Image -->
                                <Image
                                    Grid.RowSpan="2"
                                    Grid.Column="0"
                                    Source="{Binding Image}"
                                    HeightRequest="50"
                                    WidthRequest="50"
                                    Aspect="AspectFill"
                                    VerticalOptions="Center" />

                                <!-- Name -->
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding Name}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    VerticalOptions="End" />

                                <!-- Message -->
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding Message}"
                                    FontSize="14"
                                    TextColor="Gray"
                                    LineBreakMode="TailTruncation"
                                    VerticalOptions="Start" />

                                <!-- Time -->
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Text="{Binding Time}"
                                    FontSize="12"
                                    TextColor="Gray"
                                    VerticalOptions="Center" />

                            </Grid>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

        </ScrollView>

        <!-- Bottom Navigation -->
        <Grid
            Grid.Row="2"
            Padding="10,8"
            ColumnDefinitions="*,*,*,*,*">

            <!-- Activity -->
            <VerticalStackLayout
                Grid.Column="0"
                HorizontalOptions="Center">

                <Label
                    Text="⌂"
                    FontSize="22"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Activity"
                    FontSize="11"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <!-- Chat -->
            <VerticalStackLayout
                Grid.Column="1"
                HorizontalOptions="Center">

                <Label
                    Text="💬"
                    FontSize="22"
                    TextColor="#5B3A9D"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Chat"
                    FontSize="11"
                    FontAttributes="Bold"
                    TextColor="#5B3A9D"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <!-- Teams -->
            <VerticalStackLayout
                Grid.Column="2"
                HorizontalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnTeamsTapped" />
                </VerticalStackLayout.GestureRecognizers>

                <Label
                    Text="👥"
                    FontSize="22"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Teams"
                    FontSize="11"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <!-- Calendar -->
            <VerticalStackLayout
                Grid.Column="3"
                HorizontalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnCalendarTapped" />
                </VerticalStackLayout.GestureRecognizers>

                <Label
                    Text="📅"
                    FontSize="22"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Calendar"
                    FontSize="11"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <!-- More -->
            <VerticalStackLayout
                Grid.Column="4"
                HorizontalOptions="Center">

                <Label
                    Text="•••"
                    FontSize="22"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="More"
                    FontSize="11"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>