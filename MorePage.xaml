<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TeamsMobileUI.MorePage"
             Title="More">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0"
              Padding="20"
              ColumnDefinitions="Auto,*,Auto">

            <Label Text="☰"
                   FontSize="28"
                   VerticalOptions="Center" />

            <Label Grid.Column="1"
                   Text="More"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <Label Grid.Column="2"
                   Text="⚙"
                   FontSize="24"
                   VerticalOptions="Center" />

        </Grid>


        <!-- Main Content -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="20"
                                 Spacing="12">

                <!-- Profile -->
                <Border Padding="15"
                        BackgroundColor="#F5F5F5"
                        StrokeThickness="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="65,*">

                        <Image Source="sarah.jpg"
                               HeightRequest="55"
                               WidthRequest="55"
                               Aspect="AspectFill" />

                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center"
                                             Spacing="3">

                            <Label Text="Stacey"
                                   FontSize="18"
                                   FontAttributes="Bold" />

                            <Label Text="View profile"
                                   FontSize="13"
                                   TextColor="Gray" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>


                <!-- Options -->
                <Label Text="Options"
                       FontSize="20"
                       FontAttributes="Bold"
                       Margin="0,10,0,0" />


                <!-- Notifications -->
                <Border Padding="15"
                        BackgroundColor="#F5F5F5"
                        StrokeThickness="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="45,*,Auto">

                        <Label Text="🔔"
                               FontSize="22"
                               VerticalOptions="Center" />

                        <Label Grid.Column="1"
                               Text="Notifications"
                               FontSize="16"
                               VerticalOptions="Center" />

                        <Label Grid.Column="2"
                               Text="›"
                               FontSize="25"
                               TextColor="Gray"
                               VerticalOptions="Center" />

                    </Grid>

                </Border>


                <!-- Files -->
                <Border Padding="15"
                        BackgroundColor="#F5F5F5"
                        StrokeThickness="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="45,*,Auto">

                        <Label Text="📁"
                               FontSize="22"
                               VerticalOptions="Center" />

                        <Label Grid.Column="1"
                               Text="Files"
                               FontSize="16"
                               VerticalOptions="Center" />

                        <Label Grid.Column="2"
                               Text="›"
                               FontSize="25"
                               TextColor="Gray"
                               VerticalOptions="Center" />

                    </Grid>

                </Border>


                <!-- Settings -->
                <Border Padding="15"
                        BackgroundColor="#F5F5F5"
                        StrokeThickness="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="45,*,Auto">

                        <Label Text="⚙"
                               FontSize="22"
                               VerticalOptions="Center" />

                        <Label Grid.Column="1"
                               Text="Settings"
                               FontSize="16"
                               VerticalOptions="Center" />

                        <Label Grid.Column="2"
                               Text="›"
                               FontSize="25"
                               TextColor="Gray"
                               VerticalOptions="Center" />

                    </Grid>

                </Border>


                <!-- Help -->
                <Border Padding="15"
                        BackgroundColor="#F5F5F5"
                        StrokeThickness="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="45,*,Auto">

                        <Label Text="?"
                               FontSize="22"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />

                        <Label Grid.Column="1"
                               Text="Help and feedback"
                               FontSize="16"
                               VerticalOptions="Center" />

                        <Label Grid.Column="2"
                               Text="›"
                               FontSize="25"
                               TextColor="Gray"
                               VerticalOptions="Center" />

                    </Grid>

                </Border>


                <!-- About -->
                <Label Text="About"
                       FontSize="20"
                       FontAttributes="Bold"
                       Margin="0,10,0,0" />

                <Label Text="Teams Mobile UI"
                       FontSize="16"
                       FontAttributes="Bold" />

                <Label Text="A mobile interface inspired by Microsoft Teams."
                       FontSize="13"
                       TextColor="Gray" />

            </VerticalStackLayout>

        </ScrollView>


        <!-- Bottom Navigation -->
        <Grid Grid.Row="2"
              Padding="10,8"
              ColumnDefinitions="*,*,*,*,*">

            <!-- Activity -->
            <VerticalStackLayout Grid.Column="0"
                                 HorizontalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnActivityTapped" />
                </VerticalStackLayout.GestureRecognizers>

                <Label Text="⌂"
                       FontSize="22"
                       HorizontalTextAlignment="Center" />

                <Label Text="Activity"
                       FontSize="11"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- Chat -->
            <VerticalStackLayout Grid.Column="1"
                                 HorizontalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChatTapped" />
                </VerticalStackLayout.GestureRecognizers>

                <Label Text="💬"
                       FontSize="22"
                       HorizontalTextAlignment="Center" />

                <Label Text="Chat"
                       FontSize="11"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- Teams -->
            <VerticalStackLayout Grid.Column="2"
                                 HorizontalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTeamsTapped" />
                </VerticalStackLayout.GestureRecognizers>

                <Label Text="👥"
                       FontSize="22"
                       HorizontalTextAlignment="Center" />

                <Label Text="Teams"
                       FontSize="11"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- Calendar -->
            <VerticalStackLayout Grid.Column="3"
                                 HorizontalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCalendarTapped" />
                </VerticalStackLayout.GestureRecognizers>

                <Label Text="📅"
                       FontSize="22"
                       HorizontalTextAlignment="Center" />

                <Label Text="Calendar"
                       FontSize="11"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- More -->
            <VerticalStackLayout Grid.Column="4"
                                 HorizontalOptions="Center">

                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMoreTapped" />
                </VerticalStackLayout.GestureRecognizers>

                <Label Text="•••"
                       FontSize="22"
                       TextColor="#5B3A9D"
                       HorizontalTextAlignment="Center" />

                <Label Text="More"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="#5B3A9D"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>