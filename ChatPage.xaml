<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TeamsMobileUI.ChatPage"
             Title="Chat">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Chat Header -->
        <Grid
            Grid.Row="0"
            Padding="15"
            ColumnDefinitions="Auto,Auto,*,Auto">

            <!-- Back Button -->
            <Button
                Text="‹"
                FontSize="32"
                WidthRequest="45"
                HeightRequest="45"
                Padding="0" />

            <!-- Profile Picture -->
            <Image
                Grid.Column="1"
                Source="sarah.jpg"
                HeightRequest="45"
                WidthRequest="45"
                Aspect="AspectFill"
                Margin="5,0" />

            <!-- Name -->
            <VerticalStackLayout
                Grid.Column="2"
                VerticalOptions="Center"
                Margin="8,0">

                <Label
                    Text="Stacey"
                    FontSize="17"
                    FontAttributes="Bold" />

                <Label
                    Text="Available"
                    FontSize="12"
                    TextColor="Gray" />

            </VerticalStackLayout>

            <!-- More -->
            <Label
                Grid.Column="3"
                Text="•••"
                FontSize="22"
                VerticalOptions="Center" />

        </Grid>


        <!-- Messages -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="15"
                Spacing="12">

                <!-- Stacey's message -->
                <HorizontalStackLayout
                    HorizontalOptions="Start">

                    <Border
                        BackgroundColor="#F1F1F1"
                        StrokeThickness="0"
                        Padding="12"
                        MaximumWidthRequest="280">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15" />
                        </Border.StrokeShape>

                        <Label
                            Text="Hi! Did you get the document I sent?"
                            FontSize="15" />

                    </Border>

                </HorizontalStackLayout>


                <!-- Your message -->
                <HorizontalStackLayout
                    HorizontalOptions="End">

                    <Border
                        BackgroundColor="#E8DDF5"
                        StrokeThickness="0"
                        Padding="12"
                        MaximumWidthRequest="280">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15" />
                        </Border.StrokeShape>

                        <Label
                            Text="Yes, I received it. Thank you!"
                            FontSize="15" />

                    </Border>

                </HorizontalStackLayout>


                <!-- Stacey's message -->
                <HorizontalStackLayout
                    HorizontalOptions="Start">

                    <Border
                        BackgroundColor="#F1F1F1"
                        StrokeThickness="0"
                        Padding="12"
                        MaximumWidthRequest="280">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15" />
                        </Border.StrokeShape>

                        <Label
                            Text="Great! Let me know if you have any questions."
                            FontSize="15" />

                    </Border>

                </HorizontalStackLayout>


                <!-- Your message -->
                <HorizontalStackLayout
                    HorizontalOptions="End">

                    <Border
                        BackgroundColor="#E8DDF5"
                        StrokeThickness="0"
                        Padding="12"
                        MaximumWidthRequest="280">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15" />
                        </Border.StrokeShape>

                        <Label
                            Text="Will do 👍"
                            FontSize="15" />

                    </Border>

                </HorizontalStackLayout>

            </VerticalStackLayout>

        </ScrollView>


        <!-- Message Input -->
        <Grid
            Grid.Row="2"
            Padding="10"
            ColumnDefinitions="*,Auto">

            <Entry
                Placeholder="Type a message"
                HeightRequest="50" />

            <Button
                Grid.Column="1"
                Text="➤"
                FontSize="20"
                WidthRequest="50"
                HeightRequest="50"
                Padding="0" />

        </Grid>

    </Grid>

</ContentPage>