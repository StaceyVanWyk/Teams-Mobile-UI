<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TeamsMobileUI.ChatPage"
             Title="{Binding Chat.Name}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Chat Header -->
        <Grid
            Grid.Row="0"
            Padding="15"
            ColumnDefinitions="Auto,Auto,*,Auto">

            <!-- Back Button -->
            <Button
                Text="‹"
                FontSize="32"
                WidthRequest="45"
                HeightRequest="45"
                Padding="0" />

            <!-- Profile Picture -->
            <Image
                Grid.Column="1"
                Source="{Binding Chat.Image}"
                HeightRequest="45"
                WidthRequest="45"
                Aspect="AspectFill"
                Margin="5,0" />

            <!-- Name and Status -->
            <VerticalStackLayout
                Grid.Column="2"
                VerticalOptions="Center"
                Margin="8,0">

                <Label
                    Text="{Binding Chat.Name}"
                    FontSize="17"
                    FontAttributes="Bold" />

                <Label
                    Text="Available"
                    FontSize="12"
                    TextColor="Gray" />

            </VerticalStackLayout>

            <!-- More -->
            <Button Grid.Column="3"
        Text="📞"
        FontSize="20"
        WidthRequest="45"
        HeightRequest="45"
        Padding="0"
        Clicked="OnCallClicked" />

        </Grid>


        <!-- Messages -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Chat.Messages}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Grid Padding="10,6">

                        <!-- Message Bubble -->
                        <Border
                            Padding="12"
                            MaximumWidthRequest="280"
                            HorizontalOptions="Start"
                            BackgroundColor="#F1F1F1"
                            StrokeThickness="0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15" />
                            </Border.StrokeShape>

                            <Label
                                Text="{Binding Text}"
                                FontSize="15" />

                            <Border.Triggers>

                                <!-- My message -->
                                <DataTrigger
                                    TargetType="Border"
                                    Binding="{Binding IsMine}"
                                    Value="True">

                                    <Setter
                                        Property="HorizontalOptions"
                                        Value="End" />

                                    <Setter
                                        Property="BackgroundColor"
                                        Value="#E8DDF5" />

                                </DataTrigger>

                            </Border.Triggers>

                        </Border>

                    </Grid>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>


        <!-- Message Input -->
        <Grid
            Grid.Row="2"
            Padding="10"
            ColumnDefinitions="*,Auto">

            <Entry
                Placeholder="Type a message"
                HeightRequest="50" />

            <Button
                Grid.Column="1"
                Text="➤"
                FontSize="20"
                WidthRequest="50"
                HeightRequest="50"
                Padding="0" />

        </Grid>

    </Grid>

</ContentPage>