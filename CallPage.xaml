<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TeamsMobileUI.CallPage"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="#1F1F1F">

        <!-- Call Information -->
        <VerticalStackLayout Grid.Row="0"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="15">

            <Image Source="sarah.jpg"
                   HeightRequest="130"
                   WidthRequest="130"
                   Aspect="AspectFill" />

            <Label Text="Stacey"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="CallStatusLabel"
                   Text="Calling..."
                   FontSize="16"
                   TextColor="LightGray"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="CallTimerLabel"
                   Text="00:00"
                   FontSize="15"
                   TextColor="LightGray"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>


        <!-- Call Controls -->
        <Grid Grid.Row="1"
              Padding="25,20,25,35"
              ColumnDefinitions="*,*,*,*"
              ColumnSpacing="15">

            <!-- Mute -->
            <VerticalStackLayout Grid.Column="0"
                                 HorizontalOptions="Center">

                <Button Text="🎤"
                        FontSize="22"
                        WidthRequest="55"
                        HeightRequest="55"
                        CornerRadius="28"
                        Clicked="OnMuteClicked" />

                <Label x:Name="MuteLabel"
                       Text="Mute"
                       TextColor="White"
                       FontSize="12"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- Camera -->
            <VerticalStackLayout Grid.Column="1"
                                 HorizontalOptions="Center">

                <Button Text="📹"
                        FontSize="22"
                        WidthRequest="55"
                        HeightRequest="55"
                        CornerRadius="28"
                        Clicked="OnCameraClicked" />

                <Label x:Name="CameraLabel"
                       Text="Camera"
                       TextColor="White"
                       FontSize="12"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- Speaker -->
            <VerticalStackLayout Grid.Column="2"
                                 HorizontalOptions="Center">

                <Button Text="🔊"
                        FontSize="22"
                        WidthRequest="55"
                        HeightRequest="55"
                        CornerRadius="28"
                        Clicked="OnSpeakerClicked" />

                <Label x:Name="SpeakerLabel"
                       Text="Speaker"
                       TextColor="White"
                       FontSize="12"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- End Call -->
            <VerticalStackLayout Grid.Column="3"
                                 HorizontalOptions="Center">

                <Button Text="📞"
                        FontSize="22"
                        WidthRequest="55"
                        HeightRequest="55"
                        CornerRadius="28"
                        BackgroundColor="#D13438"
                        TextColor="White"
                        Clicked="OnEndCallClicked" />

                <Label Text="End"
                       TextColor="White"
                       FontSize="12"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>