<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TeamsMobileUI.CallPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid
        RowDefinitions="Auto,*,Auto"
        BackgroundColor="#1F1F1F">

        <!-- ========================= -->
        <!-- Call Header -->
        <!-- ========================= -->

        <Grid
            Grid.Row="0"
            Padding="20,15"
            ColumnDefinitions="*,Auto">

            <VerticalStackLayout>

                <Label
                    Text="Group call"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White" />

                <HorizontalStackLayout Spacing="8">

                    <Label
                        x:Name="CallStatusLabel"
                        Text="Calling..."
                        FontSize="13"
                        TextColor="LightGray" />

                    <Label
                        Text="•"
                        FontSize="13"
                        TextColor="LightGray" />

                    <Label
                        x:Name="CallTimerLabel"
                        Text="00:00"
                        FontSize="13"
                        TextColor="LightGray" />

                </HorizontalStackLayout>

            </VerticalStackLayout>

            <!-- More -->
            <Label
                Grid.Column="1"
                Text="•••"
                FontSize="22"
                TextColor="White"
                VerticalOptions="Center" />

        </Grid>


        <!-- ========================= -->
        <!-- Participants -->
        <!-- ========================= -->

        <Grid
            x:Name="ParticipantsGrid"
            Grid.Row="1"
            Padding="12,5"
            RowDefinitions="*,*"
            ColumnDefinitions="*,*"
            RowSpacing="10"
            ColumnSpacing="10">

            <!-- Stacey -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                BackgroundColor="#303030"
                StrokeThickness="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid>

                    <Image
                        Source="sarah.jpg"
                        Aspect="AspectFill" />

                    <Border
                        BackgroundColor="#00000080"
                        StrokeThickness="0"
                        VerticalOptions="End"
                        Padding="8">

                        <Label
                            Text="Stacey"
                            FontSize="14"
                            TextColor="White"
                            FontAttributes="Bold" />

                    </Border>

                </Grid>

            </Border>


            <!-- John -->
            <Border
                Grid.Row="0"
                Grid.Column="1"
                BackgroundColor="#303030"
                StrokeThickness="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid>

                    <Image
                        Source="john.jpg"
                        Aspect="AspectFill" />

                    <Border
                        BackgroundColor="#00000080"
                        StrokeThickness="0"
                        VerticalOptions="End"
                        Padding="8">

                        <Label
                            Text="John"
                            FontSize="14"
                            TextColor="White"
                            FontAttributes="Bold" />

                    </Border>

                </Grid>

            </Border>


            <!-- Lisa -->
            <Border
                Grid.Row="1"
                Grid.Column="0"
                BackgroundColor="#303030"
                StrokeThickness="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid>

                    <Image
                        Source="lisa.jpg"
                        Aspect="AspectFill" />

                    <Border
                        BackgroundColor="#00000080"
                        StrokeThickness="0"
                        VerticalOptions="End"
                        Padding="8">

                        <Label
                            Text="Lisa"
                            FontSize="14"
                            TextColor="White"
                            FontAttributes="Bold" />

                    </Border>

                </Grid>

            </Border>


            <!-- Michael -->
            <Border
                Grid.Row="1"
                Grid.Column="1"
                BackgroundColor="#303030"
                StrokeThickness="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid>

                    <Image
                        Source="michael.jpg"
                        Aspect="AspectFill" />

                    <Border
                        BackgroundColor="#00000080"
                        StrokeThickness="0"
                        VerticalOptions="End"
                        Padding="8">

                        <Label
                            Text="Michael"
                            FontSize="14"
                            TextColor="White"
                            FontAttributes="Bold" />

                    </Border>

                </Grid>

            </Border>

        </Grid>

        <!-- ========================= -->
        <!-- Participants Panel -->
        <!-- ========================= -->

        <Border
            x:Name="ParticipantsPanel"
            Grid.Row="1"
            Margin="40,20"
            BackgroundColor="#2B2B2B"
            StrokeThickness="0"
            IsVisible="False"
            ZIndex="10">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15" />
            </Border.StrokeShape>

            <VerticalStackLayout
                Padding="20"
                Spacing="18">

                <Label
                    Text="People"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="White" />

                <!-- Stacey -->
                <HorizontalStackLayout Spacing="12">

                    <Image
                        Source="sarah.jpg"
                        HeightRequest="45"
                        WidthRequest="45"
                        Aspect="AspectFill" />

                    <VerticalStackLayout VerticalOptions="Center">

                        <Label
                            Text="Stacey"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Connected"
                            FontSize="12"
                            TextColor="LightGray" />

                    </VerticalStackLayout>

                </HorizontalStackLayout>


                <!-- John -->
                <HorizontalStackLayout Spacing="12">

                    <Image
                        Source="john.jpg"
                        HeightRequest="45"
                        WidthRequest="45"
                        Aspect="AspectFill" />

                    <VerticalStackLayout VerticalOptions="Center">

                        <Label
                            Text="John"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Connected"
                            FontSize="12"
                            TextColor="LightGray" />

                    </VerticalStackLayout>

                </HorizontalStackLayout>


                <!-- Lisa -->
                <HorizontalStackLayout Spacing="12">

                    <Image
                        Source="lisa.jpg"
                        HeightRequest="45"
                        WidthRequest="45"
                        Aspect="AspectFill" />

                    <VerticalStackLayout VerticalOptions="Center">

                        <Label
                            Text="Lisa"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Connected"
                            FontSize="12"
                            TextColor="LightGray" />

                    </VerticalStackLayout>

                </HorizontalStackLayout>


                <!-- Michael -->
                <HorizontalStackLayout Spacing="12">

                    <Image
                        Source="michael.jpg"
                        HeightRequest="45"
                        WidthRequest="45"
                        Aspect="AspectFill" />

                    <VerticalStackLayout VerticalOptions="Center">

                        <Label
                            Text="Michael"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Connected"
                            FontSize="12"
                            TextColor="LightGray" />

                    </VerticalStackLayout>

                </HorizontalStackLayout>

            </VerticalStackLayout>

        </Border>
        <!-- ========================= -->
        <!-- Meeting Chat Panel -->
        <!-- ========================= -->

        <Border
    x:Name="MeetingChatPanel"
    Grid.Row="1"
    Margin="25,15"
    BackgroundColor="#2B2B2B"
    StrokeThickness="0"
    IsVisible="False"
    ZIndex="10">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Chat Header -->
                <Grid
            Grid.Row="0"
            Padding="15"
            ColumnDefinitions="*,Auto">

                    <Label
                Text="Meeting chat"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="White" />

                    <Label
                Grid.Column="1"
                Text="✕"
                FontSize="20"
                TextColor="White" />

                </Grid>


                <!-- Messages -->
                <ScrollView Grid.Row="1">

                    <VerticalStackLayout
                Padding="15"
                Spacing="12">

                        <Label
                    Text="John"
                    FontSize="12"
                    TextColor="LightGray" />

                        <Border
                    BackgroundColor="#3A3A3A"
                    StrokeThickness="0"
                    Padding="10">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Label
                        Text="Hi everyone!"
                        TextColor="White"
                        FontSize="14" />

                        </Border>


                        <Label
                    Text="Lisa"
                    FontSize="12"
                    TextColor="LightGray" />

                        <Border
                    BackgroundColor="#3A3A3A"
                    StrokeThickness="0"
                    Padding="10">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Label
                        Text="Are we starting the presentation now?"
                        TextColor="White"
                        FontSize="14" />

                        </Border>


                        <Label
                    Text="Stacey"
                    FontSize="12"
                    TextColor="LightGray" />

                        <Border
                    BackgroundColor="#5B3A9D"
                    StrokeThickness="0"
                    Padding="10">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Label
                        Text="Yes, let's start."
                        TextColor="White"
                        FontSize="14" />

                        </Border>

                    </VerticalStackLayout>

                </ScrollView>


                <!-- Message Input -->
                <Grid
            Grid.Row="2"
            Padding="10"
            ColumnDefinitions="*,Auto">

                    <Entry
                Placeholder="Type a message..."
                PlaceholderColor="LightGray"
                TextColor="White"
                BackgroundColor="#3A3A3A"
                HeightRequest="45" />

                    <Button
                Grid.Column="1"
                Text="➤"
                FontSize="18"
                WidthRequest="45"
                HeightRequest="45"
                Padding="0" />

                </Grid>

            </Grid>

        </Border>

        <!-- ========================= -->
        <!-- Screen Sharing -->
        <!-- ========================= -->

        <Border
    x:Name="ScreenShareView"
    Grid.Row="1"
    Margin="12,5"
    BackgroundColor="#303030"
    StrokeThickness="0"
    IsVisible="False">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <VerticalStackLayout
        VerticalOptions="Center"
        HorizontalOptions="Center"
        Spacing="15">

                <Label
            Text="🖥️"
            FontSize="55"
            HorizontalTextAlignment="Center" />

                <Label
            Text="Stacey is sharing their screen"
            FontSize="20"
            FontAttributes="Bold"
            TextColor="White"
            HorizontalTextAlignment="Center" />

                <Label
            Text="Screen sharing is active"
            FontSize="14"
            TextColor="LightGray"
            HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </Border>



        <!-- ========================= -->
        <!-- Call Controls -->
        <!-- ========================= -->

        <Grid
            Grid.Row="2"
            Padding="12,10,12,20"
            ColumnDefinitions="*,*,*,*,*,*,*"
            ColumnSpacing="5">

            <!-- Mute -->
            <VerticalStackLayout
                Grid.Column="0"
                HorizontalOptions="Center">

                <Button
                    Text="🎤"
                    FontSize="20"
                    WidthRequest="48"
                    HeightRequest="48"
                    CornerRadius="24"
                    Padding="0"
                    Clicked="OnMuteClicked" />

                <Label
                    x:Name="MuteLabel"
                    Text="Mute"
                    TextColor="White"
                    FontSize="10"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- Camera -->
            <VerticalStackLayout
                Grid.Column="1"
                HorizontalOptions="Center">

                <Button
                    Text="📹"
                    FontSize="20"
                    WidthRequest="48"
                    HeightRequest="48"
                    CornerRadius="24"
                    Padding="0"
                    Clicked="OnCameraClicked" />

                <Label
                    x:Name="CameraLabel"
                    Text="Camera"
                    TextColor="White"
                    FontSize="10"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- Share Screen -->
            <VerticalStackLayout
                Grid.Column="2"
                HorizontalOptions="Center">

                <Button
                    x:Name="ShareButton"
                    Text="🖥️"
                    FontSize="19"
                    WidthRequest="48"
                    HeightRequest="48"
                    CornerRadius="24"
                    Padding="0"
                    Clicked="OnShareScreenClicked"/>

                <Label
                    x:Name="ShareLabel"
                    Text="Share"
                    TextColor="White"
                    FontSize="10"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- Participants -->
            <VerticalStackLayout
                Grid.Column="3"
                HorizontalOptions="Center">

                <Button
                    Text="👥"
                    FontSize="19"
                    WidthRequest="48"
                    HeightRequest="48"
                    CornerRadius="24"
                    Padding="0"
                    Clicked="OnParticipantsClicked"/>

                <Label
                    Text="People"
                    TextColor="White"
                    FontSize="10"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- Chat -->
            <VerticalStackLayout
                Grid.Column="4"
                HorizontalOptions="Center">

                <Button
                    Text="💬"
                    FontSize="19"
                    WidthRequest="48"
                    HeightRequest="48"
                    CornerRadius="24"
                    Padding="0"
                    Clicked="OnMeetingChatClicked"/>

                <Label
                    Text="Chat"
                    TextColor="White"
                    FontSize="10"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- Speaker -->
            <VerticalStackLayout
                Grid.Column="5"
                HorizontalOptions="Center">

                <Button
                    Text="🔊"
                    FontSize="19"
                    WidthRequest="48"
                    HeightRequest="48"
                    CornerRadius="24"
                    Padding="0"
                    Clicked="OnSpeakerClicked" />

                <Label
                    x:Name="SpeakerLabel"
                    Text="Speaker"
                    TextColor="White"
                    FontSize="10"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- End Call -->
            <VerticalStackLayout
                Grid.Column="6"
                HorizontalOptions="Center">

                <Button
                    Text="📞"
                    FontSize="20"
                    WidthRequest="48"
                    HeightRequest="48"
                    CornerRadius="24"
                    BackgroundColor="#D13438"
                    TextColor="White"
                    Padding="0"
                    Clicked="OnEndCallClicked" />

                <Label
                    Text="End"
                    TextColor="White"
                    FontSize="10"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>